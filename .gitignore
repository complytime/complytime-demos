# editor and IDE paraphernalia
.idea
*.swp
*.swo
*~
.vscode

# VMs
.vagrant/

# Ignore local changes to this file
base_ansible_env/ansible_inventory
base_ansible_env/downloads_complyctl_*
base_ansible_env/downloads_merge_readiness/

# Speckit — managed by specify init (recreate with: specify init --ai opencode)
.specify/extensions.yml
.specify/extensions/
.specify/init-options.json
.specify/integration.json
.specify/integrations/
.specify/scripts
.specify/templates
.specify/workflows/
.opencode/commands/speckit.*.md
.opencode/commands/opsx-*.md
.opencode/skills/speckit-workflow/
.opencode/skills/openspec-*/

# Agent dirs
.cursor
.claude

# Unbound Force — managed by uf init
# Runtime data under .uf/ (databases, caches, locks, logs)
.uf/feedback/
.uf/workflows/
.uf/artifacts/
.uf/dewey/graph.db
.uf/dewey/graph.db-shm
.uf/dewey/graph.db-wal
.uf/dewey/*.lock
.uf/dewey/cache/
.uf/dewey/dewey.log
.uf/replicator/*.db
.uf/replicator/*.db-shm
.uf/replicator/*.db-wal
.uf/replicator/*.lock
.uf/muti-mind/artifacts/
.uf/mx-f/data/
# Devcontainer — OS-specific, generated by uf sandbox init
.devcontainer/
# Legacy tool directories (renamed to .uf/ in Spec 025)
.dewey/
.hive/
.unbound-force/
.muti-mind/
.mx-f/
